{
	"name": "@juliusbrussee/caveman-agent",
	"version": "0.65.3",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@juliusbrussee/caveman-ai": "^0.65.2",
		"@sinclair/typebox": "^0.34.41"
	},
	"optionalDependencies": {
		"onnxruntime-node": "^1.20.0",
		"web-tree-sitter": "^0.25.10"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Julius Brussee",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JuliusBrussee/caveman-code.git",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.73.0",
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"homepage": "https://github.com/JuliusBrussee/caveman-code#readme",
	"bugs": {
		"url": "https://github.com/JuliusBrussee/caveman-code/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
